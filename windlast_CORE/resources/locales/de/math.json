{
  "schemaVersion": 1,
  "entries": {
    "abminderungsfaktor_schlankheit": {
      "label": "Abminderungsfaktor zur Berücksichtigung der Schlankheit",
      "symbol": "\\psi_\\lambda"
    },
    "abminderungsfaktor_schlankheit_rohr": {
      "label": "Abminderungsfaktor zur Berücksichtigung der Schlankheit",
      "symbol": "\\psi_\\lambda"
    },
    "eingeschlossene_flaeche": {
      "label": "Eingeschlossene Fläche",
      "symbol": "A_{C,i}"
    },
    "eingeschlossene_flaeche_traverse": {
      "label": "Eingeschlossene Fläche",
      "symbol": "A_{C,i}",
      "formula": "A_{C,i} = l_i \\cdot h_\\text{Trav}"
    },
    "grundkraftbeiwert": {
      "label": "Grundkraftbeiwert",
      "symbol": "c_{f,0}",
      "formula": "c_{f,0} = \\frac{F_{f,0}}{q_p \\cdot A_{ref}}"
    },
    "reibwert": {
      "label": "Reibwert",
      "symbol": "\\mu",
      "formula": "\\mu = \\min_k\\left(\\mu_k\\right)"
    },


    "abhebe_normalkraft_down_element": {
      "label": "Normalkraft nach unten",
      "symbol": "N_{down,k}",
      "formula": "N_{\\text{down},k} = N_{\\text{down},G,k} + N_{\\text{down},W,k}"
    },
    "abhebe_normalkraft_up_element": {
      "label": "Normalkraft nach oben",
      "symbol": "N_{up,k}",
      "formula": "N_{\\text{up},k} = N_{\\text{up},G,k} + N_{\\text{up},W,k}"
    },
    "abhebe_normalkraft_down_richtung": {
      "label": "Normalkraft nach unten",
      "symbol": "N_{down,m}",
      "formula": "N_{\\text{down},m} = \\sum_k N_{\\text{down},k}"
    },
    "abhebe_normalkraft_up_richtung": {
      "label": "Normalkraft nach oben",
      "symbol": "N_{up,m}",
      "formula": "N_{\\text{up},m} = \\sum_k N_{\\text{up},k}"
    },
    "abhebe_sicherheit_richtung": {
      "label": "Abhebesicherheit",
      "symbol": "S_{\\text{Abhebe},m}",
      "formula": [
        "\\begin{cases}",
        "\\infty &\\text{für } N_{\\text{up},m}=0\\\\",
        "\\frac{N_{\\text{down},m}}{N_{\\text{up},m}} &\\text{für } N_{\\text{up},m}>0",
        "\\end{cases}"
      ]
    },
    "abhebe_sicherheit": {
      "label": "Abhebesicherheit",
      "symbol": "S_{\\text{Abhebe}}",
      "formula": "S_\\text{Abhebe} = \\min_m \\left(S_{\\text{Abhebe},m}\\right)"
    },
    "abhebe_ballast_richtung": {
      "label": "Ballastkraft",
      "symbol": "F_{\\text{Ball,Abhebe},m}",
      "formula": [
        "F_{\\text{Ball,Abhebe},m} = \\begin{cases}",
        "0 &\\text{für } N_{\\text{up},m} = 0\\\\",
        "\\max \\left(0, \\frac{N_{\\text{up},m} - N_{\\text{down},m}}{\\gamma_\\text{Ball}}\\right) &\\text{für } N_{\\text{up},m} > 0",
        "\\end{cases}"
      ]
    },
    "abhebe_ballast": {
      "label": "Ballast",
      "symbol": "m_\\text{Ball,Abhebe}",
      "formula": [
        "\\begin{aligned}",
        "F_\\text{Ball,Abhebe} &= \\max_m F_{\\text{Ball,Abhebe},m} \\\\",
        "m_\\text{Ball,Abhebe} &= \\frac{F_\\text{Ball,Abhebe}}{g}",
        "\\end{aligned}"
      ]
    },
    "gleit_horizontalkraft_element": {
      "label": "Horizontalkraft",
      "symbol": "\\vec{H}_k",
      "formula": "\\vec{H}_k = \\vec{H}_j \\quad \\text{für das } j \\text{ mit maximalem } H_j"
    },
    "gleit_normalkraft_down_element": {
      "label": "Normalkraft nach unten",
      "symbol": "N_{\\text{down},k}",
      "formula": "N_{\\text{down},k} = N_{\\text{down},j} \\quad \\text{für das } j \\text{ mit minimalem } N_{\\text{eff},j}"
    },
    "gleit_normalkraft_up_element": {
      "label": "Normalkraft nach oben",
      "symbol": "N_{\\text{up},k}",
      "formula": "N_{\\text{up},k} = N_{\\text{up},j} \\quad \\text{für das } j \\text{ mit maximalem } H_j"
    },
    "gleit_horizontalkraft_richtung": {
      "label": "Horizontalkraft",
      "symbol": "H_m",
      "formula": [
        "\\begin{aligned}",
        "\\vec{H}_m &= \\sum_k \\vec{H}_k\\\\",
        "H_m &= \\left\\|\\vec{H}_m\\right\\|",
        "\\end{aligned}"
      ]
    },
    "gleit_normalkraft_down_richtung": {
      "label": "Normalkraft nach unten",
      "symbol": "N_{\\text{down},m}",
      "formula": "N_{\\text{down},m} = \\sum_k N_{\\text{down},k}"
    },
    "gleit_normalkraft_up_richtung": {
      "label": "Normalkraft nach oben",
      "symbol": "N_{\\text{up},m}",
      "formula": "N_{\\text{up},m} = \\sum_k N_{\\text{up},k}"
    },
    "gleit_normalkraft_effektiv_richtung": {
      "label": "Effektive Normalkraft",
      "symbol": "N_{\\text{eff},m}",
      "formula": "N_{\\text{eff},m} = \\max\\left(0, N_{\\text{down},m} - N_{\\text{up},m}\\right)"
    },
    "gleit_reibkraft_richtung": {
      "label": "Reibkraft",
      "symbol": "F_{R,m}",
      "formula": "F_{R,m} = \\mu \\cdot N_{\\text{eff},m}"
    },
    "gleit_sicherheit_richtung": {
      "label": "Gleitsicherheit",
      "symbol": "S_{\\text{Gleit},m}",
      "formula": "S_{\\text{Gleit},m} = \\frac{F_{R,m}}{H_m}"
    },
    "gleit_sicherheit": {
      "label": "Gleitsicherheit",
      "symbol": "S_{\\text{Gleit}}",
      "formula": "S_\\text{Gleit} = \\min_m \\left(S_{\\text{Gleit},m}\\right)"
    },
    "gleit_ballast_richtung": {
      "label": "Ballastkraft",
      "symbol": "F_{\\text{Ball,Gleit},m}",
      "formula": [
        "F_{\\text{Ball,Gleit},m} = \\begin{cases}",
        "\\infty &\\text{für } \\mu = 0,\\:H_m > 0\\\\",
        "0 &\\text{für } \\mu = 0,\\:H_m = 0\\\\",
        "\\max\\left(0, \\frac{\\frac{H_m}{\\mu} + N_{\\text{up},m} - N_{\\text{down},m}}{\\gamma_\\text{Ball}}\\right) &\\text{für } \\mu > 0",
        "\\end{cases}"
      ]
    },
    "gleit_ballast": {
      "label": "Ballast",
      "symbol": "m_\\text{Ball,Gleit}",
      "formula": [
        "\\begin{aligned}",
        "F_\\text{Ball,Gleit} &= \\max_m F_{\\text{Ball,Gleit},m} \\\\",
        "m_\\text{Ball,Gleit} &= \\frac{F_\\text{Ball,Gleit}}{g}",
        "\\end{aligned}"
      ]
    }
  }
}